# Production environment variables for LifeLink Pakistan Frontend
# Copy this file to .env.production.local and adjust values for your environment

# Backend API URL (MUST NOT include /api/v1 - that's handled by the client)
NEXT_PUBLIC_API_URL=https://api.lifelinkpakistan.com/api/v1

# Analytics and Monitoring (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# NEXT_PUBLIC_GA_ID=UA-XXXXXXXXX-X

# Feature flags
NEXT_PUBLIC_ENABLE_DEBUG_LOGGING=false

# App Version (automatically populated)
# NEXT_PUBLIC_APP_VERSION=1.0.0
