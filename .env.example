# LifeLink Pakistan — Root Environment Variables
# Copy this file to .env.local and adjust values for your environment.
# For backend environment variables, see lifelinkbackend/.env.example

# ── Frontend (Next.js) ─────────────────────────────────────────────────────────

# Backend API URL (no trailing slash)
# Development:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Production (example):
# NEXT_PUBLIC_API_URL=https://api.lifelinkpakistan.com/api/v1

# ── Backend ────────────────────────────────────────────────────────────────────
# The following are used by lifelinkbackend/.env (see lifelinkbackend/.env.example)

APP_NAME=LifeLink Pakistan API
ENVIRONMENT=development

# Database (SQLite by default; swap for Postgres/MySQL by changing the URL)
DATABASE_URL=sqlite:///./lifelink.db

# Auth
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_a8f5f167f44f4964e6c998dee827110c
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma-separated list is NOT supported here; edit app/core/config.py
# CORS_ORIGINS defaults to http://localhost:3000

# Seeding (set to true for development, false for production)
SEED_ON_STARTUP=true

# AI / Gemini API Key
GEMINI_API_KEY=

